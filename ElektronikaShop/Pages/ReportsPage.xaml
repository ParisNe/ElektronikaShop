<Page x:Class="ElektronikaShop.Pages.ReportsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ElektronikaShop.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Отчеты">

    <Grid Background="#FFFFFF"
          Margin="30">

        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center">

            <TextBlock Text="Формирование отчетов"
                       FontSize="30"
                       FontWeight="Bold"
                       Foreground="#323B78"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,30"/>

            <Button Content="Выгрузить заказы в Excel"
                    Width="300"
                    Height="50"
                    Margin="10"
                    Click="ExportExcelButton_Click"/>

            <Button Content="Выгрузить заказы в Word"
                    Width="300"
                    Height="50"
                    Margin="10"
                    Background="#275E9F"
                    Click="ExportWordButton_Click"/>

            <TextBlock x:Name="MessageTextBlock"
                       Foreground="#0198AF"
                       FontSize="16"
                       TextWrapping="Wrap"
                       HorizontalAlignment="Center"
                       Margin="10"/>
        </StackPanel>
    </Grid>
</Page>
