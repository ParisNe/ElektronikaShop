<Page x:Class="ElektronikaShop.Pages.OrdersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ElektronikaShop.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Мои заказы">

    <Grid Background="{DynamicResource PageBrush}" Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Мои заказы"
                   FontSize="30"
                   FontWeight="Bold"
                   Foreground="#323B78"
                   Margin="6,0,6,15"/>

        <DataGrid x:Name="OrdersDataGrid"
                  Grid.Row="1"
                  Margin="6"
                  AutoGenerateColumns="False"
                  IsReadOnly="True">

            <DataGrid.Columns>

                <DataGridTextColumn Header="Код"
                                    Binding="{Binding OrderId}"
                                    Width="70"/>

                <DataGridTextColumn Header="Номер заказа"
                                    Binding="{Binding OrderNumber}"
                                    Width="170"/>

                <DataGridTextColumn Header="Статус"
                                    Binding="{Binding Status}"
                                    Width="160"/>

                <DataGridTextColumn Header="Адрес доставки"
                                    Binding="{Binding DeliveryAddress}"
                                    Width="*"/>

                <DataGridTextColumn Header="Сумма"
                                    Binding="{Binding TotalAmount, StringFormat={}{0:N2} ₽}"
                                    Width="140"/>

                <DataGridTextColumn Header="Дата заказа"
                                    Binding="{Binding CreatedAt, StringFormat={}{0:dd.MM.yyyy HH:mm}}"
                                    Width="170"/>

            </DataGrid.Columns>
        </DataGrid>

    </Grid>
</Page>
