<Page x:Class="ElektronikaShop.Pages.AuthPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ElektronikaShop.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Авторизация">

    <Grid Background="#FFFFFF">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="420"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="1"
                Width="380"
                Padding="30"
                Background="#F3F3F3"
                CornerRadius="12"
                VerticalAlignment="Center">

            <StackPanel>

                <TextBlock Text="Авторизация"
                           FontSize="30"
                           FontWeight="Bold"
                           Foreground="#323B78"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,25"/>

                <TextBlock Text="Логин"
                           FontSize="14"
                           Margin="6,0,6,4"/>

                <TextBox x:Name="LoginTextBox"
                         Height="36"
                         Margin="6"
                         ToolTip="Введите логин"/>

                <TextBlock Text="Пароль"
                           FontSize="14"
                           Margin="6,10,6,4"/>

                <PasswordBox x:Name="PasswordBox"
                             Height="36"
                             Margin="6"
                             ToolTip="Введите пароль"/>
                
                <StackPanel x:Name="CaptchaPanel"
                    Visibility="Collapsed">

                            <TextBlock Text="Введите код с картинки"
                       Margin="6,10,6,4"/>

                            <Border Background="#FFFFFF"
                    BorderBrush="#275E9F"
                    BorderThickness="1"
                    Margin="6"
                    Padding="10">

                                <TextBlock x:Name="CaptchaCodeTextBlock"
                           Text="-----"
                           FontSize="26"
                           FontWeight="Bold"
                           Foreground="#275E9F"
                           HorizontalAlignment="Center"/>
                            </Border>

                            <TextBox x:Name="CaptchaTextBox"
                     Height="36"
                     Margin="6"
                     ToolTip="Введите код с картинки"/>
                 </StackPanel>
                
                <TextBlock x:Name="ErrorTextBlock"
                           Foreground="#E34242"
                           TextWrapping="Wrap"
                           Margin="6,12,6,4"/>

                <Button Content="Войти"
                        Height="40"
                        Margin="6,15,6,6"
                        Background="#0198AF"
                        Foreground="White"
                        Click="LoginButton_Click"/>

                <Button Content="Зарегистрироваться"
                        Height="40"
                        Margin="6"
                        Background="#323B78"
                        Foreground="White"
                        Click="RegisterButton_Click"/>

            </StackPanel>
        </Border>

    </Grid>
</Page>
