<Page x:Class="ElektronikaShop.Pages.ChangePasswordPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ElektronikaShop.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Смена пароля"
      Background="{DynamicResource PageBrush}">

    <Grid Background="{DynamicResource PageBrush}">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="430"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="1"
                Padding="30"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="12"
                VerticalAlignment="Center">

            <StackPanel>

                <TextBlock Text="Смена пароля"
                           FontSize="30"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,25"/>

                <TextBlock Text="Текущий пароль"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextBrush}"
                           Margin="6,5,6,2"/>

                <PasswordBox x:Name="OldPasswordBox"
                             Height="36"
                             Margin="6"
                             Background="{DynamicResource InputBrush}"
                             Foreground="{DynamicResource TextBrush}"
                             BorderBrush="{DynamicResource BorderBrush}"
                             ToolTip="Введите текущий пароль"/>

                <TextBlock Text="Новый пароль"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextBrush}"
                           Margin="6,10,6,2"/>

                <PasswordBox x:Name="NewPasswordBox"
                             Height="36"
                             Margin="6"
                             Background="{DynamicResource InputBrush}"
                             Foreground="{DynamicResource TextBrush}"
                             BorderBrush="{DynamicResource BorderBrush}"
                             ToolTip="Минимум 8 символов"/>

                <TextBlock Text="Повторите новый пароль"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextBrush}"
                           Margin="6,10,6,2"/>

                <PasswordBox x:Name="RepeatPasswordBox"
                             Height="36"
                             Margin="6"
                             Background="{DynamicResource InputBrush}"
                             Foreground="{DynamicResource TextBrush}"
                             BorderBrush="{DynamicResource BorderBrush}"
                             ToolTip="Повторите новый пароль"/>

                <TextBlock x:Name="MessageTextBlock"
                           Foreground="{DynamicResource DangerBrush}"
                           TextWrapping="Wrap"
                           Margin="6,12,6,4"/>

                <Button Content="Сохранить новый пароль"
                        Height="42"
                        Margin="6,15,6,6"
                        Foreground="White"
                        Background="{DynamicResource PrimaryBrush}"
                        Click="SaveButton_Click"/>

            </StackPanel>
        </Border>
    </Grid>
</Page>
