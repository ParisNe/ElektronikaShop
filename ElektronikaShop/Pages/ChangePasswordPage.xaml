<Page x:Class="ElektronikaShop.Pages.ChangePasswordPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ElektronikaShop.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Смена пароля">

    <Grid Background="#FFFFFF">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="430"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="1"
                Padding="30"
                Background="#F3F3F3"
                CornerRadius="12"
                VerticalAlignment="Center">

            <StackPanel>

                <TextBlock Text="Смена пароля"
                           FontSize="30"
                           FontWeight="Bold"
                           Foreground="#323B78"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,25"/>

                <TextBlock Text="Текущий пароль"
                           FontWeight="Bold"
                           Margin="6,5,6,2"/>

                <PasswordBox x:Name="OldPasswordBox"
                             Height="36"
                             Margin="6"/>

                <TextBlock Text="Новый пароль"
                           FontWeight="Bold"
                           Margin="6,10,6,2"/>

                <PasswordBox x:Name="NewPasswordBox"
                             Height="36"
                             Margin="6"/>

                <TextBlock Text="Повторите новый пароль"
                           FontWeight="Bold"
                           Margin="6,10,6,2"/>

                <PasswordBox x:Name="RepeatPasswordBox"
                             Height="36"
                             Margin="6"/>

                <TextBlock x:Name="MessageTextBlock"
                           Foreground="#E34242"
                           TextWrapping="Wrap"
                           Margin="6,12,6,4"/>

                <Button Content="Сохранить новый пароль"
                        Height="40"
                        Margin="6,10,6,6"
                        Click="SaveButton_Click"/>

            </StackPanel>
        </Border>
    </Grid>
</Page>
