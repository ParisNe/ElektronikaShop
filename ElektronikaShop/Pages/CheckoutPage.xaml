<Page x:Class="ElektronikaShop.Pages.CheckoutPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ElektronikaShop.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Оформление заказа">

    <Grid Background="{DynamicResource PageBrush}" Margin="30">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="430"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="1"
                Padding="30"
                Background="#F3F3F3"
                CornerRadius="12"
                VerticalAlignment="Center">

            <StackPanel>

                <TextBlock Text="Оформление заказа"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="#323B78"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,25"/>

                <TextBlock Text="Адрес доставки"
                           FontWeight="Bold"
                           Margin="6,5,6,2"/>

                <TextBox x:Name="AddressTextBox"
                         Height="80"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         ToolTip="Введите полный адрес доставки"/>

                <TextBlock Text="Итоговая сумма"
                           FontWeight="Bold"
                           Margin="6,18,6,2"/>

                <TextBlock x:Name="TotalTextBlock"
                           Text="0 ₽"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="#0198AF"
                           Margin="6"/>

                <TextBlock x:Name="MessageTextBlock"
                           Foreground="#E34242"
                           TextWrapping="Wrap"
                           Margin="6"/>

                <Button Content="Подтвердить заказ"
                        Height="42"
                        Margin="6,15,6,6"
                        Click="CreateOrderButton_Click"/>

            </StackPanel>
        </Border>
    </Grid>
</Page>
