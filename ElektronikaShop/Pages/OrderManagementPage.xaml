<Page x:Class="ElektronikaShop.Pages.OrderManagementPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ElektronikaShop.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Управление заказами">

    <Grid Background="{DynamicResource PageBrush}" Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Управление заказами"
                   FontSize="28"
                   FontWeight="Bold"
                   Foreground="#323B78"
                   Margin="6,0,6,15"/>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    Margin="6">

            <TextBlock Text="Статус заказа:"
                       VerticalAlignment="Center"
                       FontWeight="Bold"
                       Margin="4"/>

            <ComboBox x:Name="StatusComboBox"
                      Width="220"
                      Height="36"
                      Margin="6">

                <ComboBoxItem Content="Новый"/>
                <ComboBoxItem Content="Оплачен"/>
                <ComboBoxItem Content="Собирается"/>
                <ComboBoxItem Content="Доставляется"/>
                <ComboBoxItem Content="Выполнен"/>
                <ComboBoxItem Content="Отменен"/>
            </ComboBox>

            <Button Content="Изменить статус"
                    Width="150"
                    Height="36"
                    Click="ChangeStatusButton_Click"/>

            <Button Content="Обновить"
                    Width="110"
                    Height="36"
                    Background="#323B78"
                    Click="RefreshButton_Click"/>
        </StackPanel>

        <DataGrid x:Name="OrdersDataGrid"
                  Grid.Row="2"
                  Margin="6,15,6,6"
                  AutoGenerateColumns="False"
                  IsReadOnly="True">

            <DataGrid.Columns>

                <DataGridTextColumn Header="Код"
                                    Binding="{Binding OrderId}"
                                    Width="70"/>

                <DataGridTextColumn Header="Номер заказа"
                                    Binding="{Binding OrderNumber}"
                                    Width="160"/>

                <DataGridTextColumn Header="Пользователь"
                                    Binding="{Binding UserId}"
                                    Width="100"/>

                <DataGridTextColumn Header="Статус"
                                    Binding="{Binding Status}"
                                    Width="160"/>

                <DataGridTextColumn Header="Адрес доставки"
                                    Binding="{Binding DeliveryAddress}"
                                    Width="*"/>

                <DataGridTextColumn Header="Сумма"
                                    Binding="{Binding TotalAmount, StringFormat={}{0:N2} ₽}"
                                    Width="130"/>

                <DataGridTextColumn Header="Дата"
                                    Binding="{Binding CreatedAt}"
                                    Width="150"/>

            </DataGrid.Columns>
        </DataGrid>

        <TextBlock x:Name="MessageTextBlock"
                   Grid.Row="2"
                   VerticalAlignment="Bottom"
                   Margin="10"
                   Foreground="#0198AF"
                   FontSize="15"/>
    </Grid>
</Page>
