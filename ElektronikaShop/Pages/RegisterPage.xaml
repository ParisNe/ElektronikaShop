<Page x:Class="ElektronikaShop.Pages.RegisterPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ElektronikaShop.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Background="{DynamicResource PageBrush}"
      Title="Регистрация">

    <Grid Background="{DynamicResource PageBrush}">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="480"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="1"
                Padding="25"
                Background="{DynamicResource SurfaceBrush}"
                CornerRadius="12"
                VerticalAlignment="Center">

            <StackPanel>

                <TextBlock Text="Регистрация"
                           FontSize="30"
                           FontWeight="Bold"
                           Foreground="#323B78"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,20"/>

                <TextBlock Text="Логин"/>
                <TextBox x:Name="LoginTextBox"
                         Foreground="{DynamicResource TextBrush}"
                         ToolTip="Введите логин"/>

                <TextBlock Text="Пароль"/>
                <PasswordBox x:Name="PasswordBox"
                             ToolTip="Минимум 8 символов"/>

                <TextBlock Text="Повторите пароль"/>
                <PasswordBox x:Name="RepeatPasswordBox"/>

                <TextBlock Text="ФИО"/>
                <TextBox x:Name="FioTextBox"
                         ToolTip="Введите фамилию, имя и отчество"/>

                <TextBlock Text="Email"/>
                <TextBox x:Name="EmailTextBox"
                         ToolTip="example@mail.ru"/>

                <TextBlock Text="Телефон"/>
                <TextBox x:Name="PhoneTextBox"
                         ToolTip="+7 900 000-00-00"/>

                <TextBlock Text="Адрес доставки"/>
                <TextBox x:Name="AddressTextBox"
                         ToolTip="Введите адрес доставки"/>

                <TextBlock x:Name="MessageTextBlock"
                           Foreground="#E34242"
                           TextWrapping="Wrap"
                           Margin="6"/>

                <Button Content="Зарегистрироваться"
                        Height="40"
                        Click="RegisterButton_Click"/>

                <Button Content="Вернуться к авторизации"
                        Height="40"
                        Background="#323B78"
                        Click="BackButton_Click"/>

            </StackPanel>
        </Border>
    </Grid>
</Page>
