<Page x:Class="ElektronikaShop.Pages.CartPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ElektronikaShop.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Корзина">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Корзина"
                   FontSize="30"
                   FontWeight="Bold"
                   Foreground="#323B78"
                   Margin="6,0,6,15"/>

        <DataGrid x:Name="CartDataGrid"
                  Grid.Row="1"
                  Margin="6"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single">

            <DataGrid.Columns>

                <DataGridTextColumn Header="Код"
                                    Binding="{Binding ProductId}"
                                    Width="70"/>

                <DataGridTextColumn Header="Товар"
                                    Binding="{Binding ProductName}"
                                    Width="*"/>

                <DataGridTextColumn Header="Цена"
                                    Binding="{Binding Price, StringFormat={}{0:N2} ₽}"
                                    Width="140"/>

                <DataGridTextColumn Header="Количество"
                                    Binding="{Binding Quantity}"
                                    Width="120"/>

                <DataGridTextColumn Header="Стоимость"
                                    Binding="{Binding Total, StringFormat={}{0:N2} ₽}"
                                    Width="150"/>

            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">

            <TextBlock x:Name="TotalTextBlock"
                       Text="Итого: 0 ₽"
                       FontSize="18"
                       FontWeight="Bold"
                       Foreground="#323B78"
                       VerticalAlignment="Center"
                       Margin="10"/>

            <Button Content="Удалить товар"
                    Width="140"
                    Height="38"
                    Background="#E34242"
                    Click="DeleteButton_Click"/>

            <Button Content="Обновить"
                    Width="110"
                    Height="38"
                    Background="#323B78"
                    Click="RefreshButton_Click"/>

            <Button Content="Оформить заказ"
                Width="150"
                Height="38"
                Background="#0198AF"
                Click="CheckoutButton_Click"/>  

        </StackPanel>
    </Grid>
</Page>
