<Page x:Class="ElektronikaShop.Pages.CatalogPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ElektronikaShop.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Каталог товаров">

    <Grid Background="{DynamicResource PageBrush}" Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Каталог товаров"
                   FontSize="30"
                   FontWeight="Bold"
                   Foreground="#323B78"
                   Margin="10"/>

        <WrapPanel Grid.Row="1"
           Orientation="Horizontal"
           Margin="6"
           HorizontalAlignment="Left">

            <StackPanel Margin="4">

                <TextBlock Text="Поиск"
                   FontWeight="Bold"
                   Margin="2"/>

                <TextBox x:Name="SearchTextBox"
                 Width="230"
                 Height="36"
                 ToolTip="Введите название или бренд"/>
            </StackPanel>

            <StackPanel Margin="4">

                <TextBlock Text="Категория"
                   FontWeight="Bold"
                   Margin="2"/>

                <ComboBox x:Name="CategoryComboBox"
                  Width="190"
                  Height="36"
                  DisplayMemberPath="Name"
                  ToolTip="Выберите категорию"/>
            </StackPanel>

            <StackPanel Margin="4">

                <TextBlock Text="Сортировка"
                   FontWeight="Bold"
                   Margin="2"/>

                <ComboBox x:Name="SortComboBox"
                  Width="190"
                  Height="36"
                  SelectedIndex="0">

                    <ComboBoxItem Content="Без сортировки"/>
                    <ComboBoxItem Content="Цена по возрастанию"/>
                    <ComboBoxItem Content="Цена по убыванию"/>
                    <ComboBoxItem Content="Название от А до Я"/>
                </ComboBox>
            </StackPanel>

            <StackPanel Orientation="Horizontal"
                VerticalAlignment="Bottom"
                Margin="4">

                <Button Content="Найти"
                Width="100"
                Height="36"
                Click="SearchButton_Click"/>

                <Button Content="Сбросить"
                Width="105"
                Height="36"
                Background="#323B78"
                Click="ResetButton_Click"/>

                <Button Content="Добавить в корзину"
                Width="150"
                Height="36"
                Background="#0198AF"
                Click="AddToCartButton_Click"/>

                <Button Content="Корзина"
                Width="100"
                Height="36"
                Background="#323B78"
                Click="CartButton_Click"/>

                <Button Content="Мои заказы"
                Width="120"
                Height="36"
                Background="#323B78"
                Click="OrdersButton_Click"/>

                <Button Content="Сменить пароль"
                Width="140"
                Height="36"
                Background="#275E9F"
                Click="ChangePasswordButton_Click"/>
            </StackPanel>

        </WrapPanel>

        <DataGrid x:Name="ProductsDataGrid"
                  Grid.Row="2"
                  Margin="6,15,6,6"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single">

            <DataGrid.Columns>

                <DataGridTextColumn Header="Код"
                                    Binding="{Binding ProductId}"
                                    Width="70"/>

                <DataGridTextColumn Header="Название"
                                    Binding="{Binding Name}"
                                    Width="*"/>

                <DataGridTextColumn Header="Бренд"
                                    Binding="{Binding Brand}"
                                    Width="150"/>

                <DataGridTextColumn Header="Категория"
                                    Binding="{Binding CategoryName}"
                                    Width="180"/>

                <DataGridTextColumn Header="Цена"
                                    Binding="{Binding Price, StringFormat={}{0:N2} ₽}"
                                    Width="130"/>

                <DataGridTextColumn Header="Остаток"
                                    Binding="{Binding StockQuantity}"
                                    Width="100"/>

            </DataGrid.Columns>
        </DataGrid>

    </Grid>
</Page>
