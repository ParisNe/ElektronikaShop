<Page x:Class="ElektronikaShop.Pages.CatalogPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ElektronikaShop.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Каталог товаров">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Каталог товаров"
                   FontSize="30"
                   FontWeight="Bold"
                   Foreground="#323B78"
                   Margin="10"/>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal">

            <TextBox x:Name="SearchTextBox"
                     Width="280"
                     Height="36"
                     Margin="6"
                     ToolTip="Введите название или бренд"/>

            <ComboBox x:Name="CategoryComboBox"
                      Width="220"
                      Height="36"
                      Margin="6"
                      DisplayMemberPath="Name"
                      ToolTip="Выберите категорию"/>

            <ComboBox x:Name="SortComboBox"
                      Width="180"
                      Height="36"
                      Margin="6"
                      SelectedIndex="0">

                <ComboBoxItem Content="Без сортировки"/>
                <ComboBoxItem Content="Цена по возрастанию"/>
                <ComboBoxItem Content="Цена по убыванию"/>
                <ComboBoxItem Content="Название от А до Я"/>
            </ComboBox>

            <Button Content="Найти"
                    Width="110"
                    Height="36"
                    Click="SearchButton_Click"/>

            <Button Content="Сбросить"
                    Width="110"
                    Height="36"
                    Background="#323B78"
                    Click="ResetButton_Click"/>
            <Button Content="Сменить пароль"
                Width="140"
                Height="36"
                Background="#275E9F"
                Click="ChangePasswordButton_Click"/>
        </StackPanel>

        <DataGrid x:Name="ProductsDataGrid"
                  Grid.Row="2"
                  Margin="6,15,6,6"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single">

            <DataGrid.Columns>

                <DataGridTextColumn Header="Код"
                                    Binding="{Binding ProductId}"
                                    Width="70"/>

                <DataGridTextColumn Header="Название"
                                    Binding="{Binding Name}"
                                    Width="*"/>

                <DataGridTextColumn Header="Бренд"
                                    Binding="{Binding Brand}"
                                    Width="150"/>

                <DataGridTextColumn Header="Категория"
                                    Binding="{Binding CategoryName}"
                                    Width="180"/>

                <DataGridTextColumn Header="Цена"
                                    Binding="{Binding Price, StringFormat={}{0:N2} ₽}"
                                    Width="130"/>

                <DataGridTextColumn Header="Остаток"
                                    Binding="{Binding StockQuantity}"
                                    Width="100"/>

            </DataGrid.Columns>
        </DataGrid>

    </Grid>
</Page>
