<Page x:Class="ElektronikaShop.Pages.CategoryManagementPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ElektronikaShop.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Управление категориями">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Управление категориями"
                   FontSize="28"
                   FontWeight="Bold"
                   Foreground="#323B78"
                   Margin="6,0,6,15"/>

        <Grid Grid.Row="1"
              Margin="6">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="400"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0"
                        Margin="4">

                <TextBlock Text="Название категории"
                           FontWeight="Bold"
                           Margin="2"/>

                <TextBox x:Name="NameTextBox"
                         Height="36"
                         ToolTip="Например: Смартфоны"/>
            </StackPanel>

            <StackPanel Grid.Column="1"
                        Margin="4">

                <TextBlock Text="Описание категории"
                           FontWeight="Bold"
                           Margin="2"/>

                <TextBox x:Name="DescriptionTextBox"
                         Height="36"
                         ToolTip="Краткое описание категории"/>
            </StackPanel>

            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        VerticalAlignment="Bottom"
                        Margin="4">

                <Button Content="Добавить"
                        Width="110"
                        Height="36"
                        Click="AddButton_Click"/>

                <Button Content="Удалить"
                        Width="110"
                        Height="36"
                        Background="#E34242"
                        Click="DeleteButton_Click"/>

                <Button Content="Обновить"
                        Width="110"
                        Height="36"
                        Background="#323B78"
                        Click="RefreshButton_Click"/>
            </StackPanel>
        </Grid>

        <DataGrid x:Name="CategoriesDataGrid"
                  Grid.Row="2"
                  Margin="6,15,6,6"
                  AutoGenerateColumns="False"
                  IsReadOnly="True">

            <DataGrid.Columns>

                <DataGridTextColumn Header="Код"
                                    Binding="{Binding CategoryId}"
                                    Width="80"/>

                <DataGridTextColumn Header="Название"
                                    Binding="{Binding Name}"
                                    Width="250"/>

                <DataGridTextColumn Header="Описание"
                                    Binding="{Binding Description}"
                                    Width="*"/>

            </DataGrid.Columns>
        </DataGrid>

        <TextBlock x:Name="MessageTextBlock"
                   Grid.Row="2"
                   VerticalAlignment="Bottom"
                   Margin="10"
                   Foreground="#0198AF"
                   FontSize="15"/>
    </Grid>
</Page>
