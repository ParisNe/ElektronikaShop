<Page x:Class="ElektronikaShop.Pages.StatisticsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ElektronikaShop.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Статистика">

    <Grid Background="{DynamicResource PageBrush}" Margin="25">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Статистика магазина"
                   FontSize="30"
                   FontWeight="Bold"
                   Foreground="#323B78"
                   Margin="6,0,6,20"/>

        <UniformGrid Grid.Row="1"
                     Columns="4"
                     Margin="6">

            <Border Background="#0198AF"
                    CornerRadius="8"
                    Margin="6"
                    Padding="15">

                <StackPanel>
                    <TextBlock Text="Пользователи"
                               Foreground="White"
                               FontSize="15"/>

                    <TextBlock x:Name="UsersCountTextBlock"
                               Foreground="White"
                               FontSize="28"
                               FontWeight="Bold"/>
                </StackPanel>
            </Border>

            <Border Background="#275E9F"
                    CornerRadius="8"
                    Margin="6"
                    Padding="15">

                <StackPanel>
                    <TextBlock Text="Товары"
                               Foreground="White"
                               FontSize="15"/>

                    <TextBlock x:Name="ProductsCountTextBlock"
                               Foreground="White"
                               FontSize="28"
                               FontWeight="Bold"/>
                </StackPanel>
            </Border>

            <Border Background="#323B78"
                    CornerRadius="8"
                    Margin="6"
                    Padding="15">

                <StackPanel>
                    <TextBlock Text="Заказы"
                               Foreground="White"
                               FontSize="15"/>

                    <TextBlock x:Name="OrdersCountTextBlock"
                               Foreground="White"
                               FontSize="28"
                               FontWeight="Bold"/>
                </StackPanel>
            </Border>

            <Border Background="#193D57"
                    CornerRadius="8"
                    Margin="6"
                    Padding="15">

                <StackPanel>
                    <TextBlock Text="Выручка"
                               Foreground="White"
                               FontSize="15"/>

                    <TextBlock x:Name="RevenueTextBlock"
                               Foreground="White"
                               FontSize="24"
                               FontWeight="Bold"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <Grid Grid.Row="2"
              Margin="6,20,6,6">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <GroupBox Header="Продажи по категориям"
                      Grid.Column="0"
                      Margin="6">

                <DataGrid x:Name="CategoriesDataGrid"
                          AutoGenerateColumns="False"
                          IsReadOnly="True">

                    <DataGrid.Columns>

                        <DataGridTextColumn Header="Категория"
                                            Binding="{Binding CategoryName}"
                                            Width="*"/>

                        <DataGridTextColumn Header="Количество"
                                            Binding="{Binding Quantity}"
                                            Width="120"/>

                        <DataGridTextColumn Header="Сумма"
                                            Binding="{Binding Amount, StringFormat={}{0:N2} ₽}"
                                            Width="150"/>

                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>

            <GroupBox Header="Последние заказы"
                      Grid.Column="1"
                      Margin="6">

                <DataGrid x:Name="OrdersDataGrid"
                          AutoGenerateColumns="False"
                          IsReadOnly="True">

                    <DataGrid.Columns>

                        <DataGridTextColumn Header="Номер"
                                            Binding="{Binding OrderNumber}"
                                            Width="150"/>

                        <DataGridTextColumn Header="Статус"
                                            Binding="{Binding Status}"
                                            Width="130"/>

                        <DataGridTextColumn Header="Сумма"
                                            Binding="{Binding TotalAmount, StringFormat={}{0:N2} ₽}"
                                            Width="130"/>

                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>
        </Grid>
    </Grid>
</Page>
