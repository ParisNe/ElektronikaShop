<Page x:Class="ElektronikaShop.Pages.AdminDashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ElektronikaShop.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Панель администратора">

    <Grid Background="{DynamicResource PageBrush}"
          Margin="30">

        <StackPanel>

            <TextBlock Text="Панель администратора"
                       FontSize="30"
                       FontWeight="Bold"
                       Foreground="#323B78"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,30"/>

            <UniformGrid Columns="2"
                         Rows="3"
                         HorizontalAlignment="Center">

                <Button Content="Товары"
                        Width="250"
                        Height="80"
                        Margin="10"
                        Click="ProductsButton_Click"/>

                <Button Content="Категории"
                        Width="250"
                        Height="80"
                        Margin="10"
                        Click="CategoriesButton_Click"/>

                <Button Content="Заказы"
                        Width="250"
                        Height="80"
                        Margin="10"
                        Click="OrdersButton_Click"/>

                <Button Content="Пользователи"
                        Width="250"
                        Height="80"
                        Margin="10"
                        Click="UsersButton_Click"/>

                <Button Content="Графики"
                        Width="250"
                        Height="80"
                        Margin="10"
                        Click="StatisticsButton_Click"/>

                <Button Content="Отчеты"
                        Width="250"
                        Height="80"
                        Margin="10"
                        Click="ReportsButton_Click"/>

            </UniformGrid>

            <TextBlock x:Name="MessageTextBlock"
                       Foreground="#0198AF"
                       FontSize="16"
                       HorizontalAlignment="Center"
                       Margin="10"/>

        </StackPanel>
    </Grid>
</Page>
