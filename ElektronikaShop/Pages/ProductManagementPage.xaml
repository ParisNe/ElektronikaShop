<Page x:Class="ElektronikaShop.Pages.ProductManagementPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ElektronikaShop.Pages"
      mc:Ignorable="d" 
      mc:Ignorable="d"
      d:DesignHeight="600"
      d:DesignWidth="1000"
      Background="{DynamicResource PageBrush}"
      Title="Управление товарами">

    <Grid Margin="20"
          Background="{DynamicResource PageBrush}">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Управление товарами"
                   FontSize="28"
                   FontWeight="Bold"
                   Foreground="{DynamicResource TextBrush}"
                   Margin="5,0,5,18"/>

        <Grid Grid.Row="1"
              Margin="5,0,5,10">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="1.3*"/>
                <ColumnDefinition Width="1.3*"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0"
                        Margin="5">

                <TextBlock Text="Название товара"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextBrush}"
                           Margin="0,0,0,5"/>

                <TextBox x:Name="NameTextBox"
                         Height="36"
                         MinWidth="130"
                         ToolTip="Например: Смартфон X Pro"/>
            </StackPanel>

            <StackPanel Grid.Column="1"
                        Margin="5">

                <TextBlock Text="Бренд или модель"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextBrush}"
                           Margin="0,0,0,5"/>

                <TextBox x:Name="BrandTextBox"
                         Height="36"
                         MinWidth="130"
                         ToolTip="Например: Samsung Galaxy"/>
            </StackPanel>

            <StackPanel Grid.Column="2"
                        Margin="5">

                <TextBlock Text="Цена, ₽"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextBrush}"
                           Margin="0,0,0,5"/>

                <TextBox x:Name="PriceTextBox"
                         Height="36"
                         MinWidth="90"
                         ToolTip="От 0 до 10 000 000"/>
            </StackPanel>

            <StackPanel Grid.Column="3"
                        Margin="5">

                <TextBlock Text="Количество"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextBrush}"
                           Margin="0,0,0,5"/>

                <TextBox x:Name="StockTextBox"
                         Height="36"
                         MinWidth="90"
                         ToolTip="От 0 до 1 000 000"/>
            </StackPanel>

            <StackPanel Grid.Column="4"
                        Margin="5">

                <TextBlock Text="Категория"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextBrush}"
                           Margin="0,0,0,5"/>

                <ComboBox x:Name="CategoryComboBox"
                          Height="36"
                          MinWidth="130"
                          DisplayMemberPath="Name"
                          SelectedValuePath="CategoryId"
                          ToolTip="Выберите категорию"/>
            </StackPanel>

        </Grid>

        <ScrollViewer Grid.Row="2"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto"
                      Margin="5,0,5,10">

            <WrapPanel HorizontalAlignment="Center">

                <Button Content="Добавить"
                        MinWidth="120"
                        Height="36"
                        Margin="5"
                        Click="AddButton_Click"/>

                <Button Content="Изменить"
                        MinWidth="120"
                        Height="36"
                        Margin="5"
                        Click="EditProductButton_Click"/>

                <Button Content="Удалить"
                        MinWidth="120"
                        Height="36"
                        Margin="5"
                        Background="{DynamicResource DangerBrush}"
                        Click="DeleteButton_Click"/>

                <Button Content="Обновить"
                        MinWidth="120"
                        Height="36"
                        Margin="5"
                        Background="{DynamicResource NavyBrush}"
                        Click="RefreshButton_Click"/>

            </WrapPanel>
        </ScrollViewer>

        <DataGrid x:Name="ProductsDataGrid"
                  Grid.Row="3"
                  Margin="5"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  SelectionChanged="ProductsDataGrid_SelectionChanged"
                  Background="{DynamicResource SurfaceBrush}"
                  Foreground="{DynamicResource TextBrush}"
                  BorderBrush="{DynamicResource BorderBrush}"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch">

            <DataGrid.Columns>

                <DataGridTextColumn Header="Код"
                                    Binding="{Binding ProductId}"
                                    Width="70"/>

                <DataGridTextColumn Header="Название"
                                    Binding="{Binding Name}"
                                    Width="2*"/>

                <DataGridTextColumn Header="Бренд"
                                    Binding="{Binding Brand}"
                                    Width="1.5*"/>

                <DataGridTextColumn Header="Цена"
                                    Binding="{Binding Price, StringFormat=N2}"
                                    Width="120"/>

                <DataGridTextColumn Header="Остаток"
                                    Binding="{Binding StockQuantity}"
                                    Width="110"/>

                <DataGridTextColumn Header="Категория"
                                    Binding="{Binding Category.Name}"
                                    Width="1.5*"/>

            </DataGrid.Columns>
        </DataGrid>

        <TextBlock x:Name="MessageTextBlock"
                   Grid.Row="4"
                   Margin="5,8,5,0"
                   FontSize="14"
                   Foreground="{DynamicResource PrimaryBrush}"
                   TextWrapping="Wrap"/>
    </Grid>
</Page>
