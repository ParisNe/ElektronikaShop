<Page x:Class="ElektronikaShop.Pages.ProductManagementPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ElektronikaShop.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Background="{DynamicResource PageBrush}"
      Title="Управление товарами">

    <Grid Background="{DynamicResource PageBrush}" Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Управление товарами"
                   FontSize="28"
                   FontWeight="Bold"
                   Foreground="#323B78"
                   Margin="6,0,6,15"/>

        <Grid Grid.Row="1"
      Margin="6">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="190"/>
                <ColumnDefinition Width="190"/>
                <ColumnDefinition Width="170"/>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0"
                Margin="4">

                <TextBlock Text="Название товара"
                   FontWeight="Bold"
                   Margin="2"/>

                <TextBox x:Name="NameTextBox"
                 Height="36"
                 ToolTip="Например: Смартфон X Pro"/>
            </StackPanel>

            <StackPanel Grid.Column="1"
                Margin="4">

                <TextBlock Text="Бренд или модель"
                   FontWeight="Bold"
                   Margin="2"/>

                <TextBox x:Name="BrandTextBox"
                 Height="36"
                 ToolTip="Например: Samsung Galaxy"/>
            </StackPanel>

            <StackPanel Grid.Column="2"
                Margin="4">

                <TextBlock Text="Цена, ₽"
                   FontWeight="Bold"
                   Margin="2"/>

                <TextBox x:Name="PriceTextBox"
                 Height="36"
                 ToolTip="Например: 89990"/>
            </StackPanel>

            <StackPanel Grid.Column="3"
                Margin="4">

                <TextBlock Text="Количество"
                   FontWeight="Bold"
                   Margin="2"/>

                <TextBox x:Name="StockTextBox"
                 Height="36"
                 ToolTip="Количество товара на складе"/>
            </StackPanel>

            <StackPanel Grid.Column="4"
                Margin="4">

                <TextBlock Text="Категория"
                   FontWeight="Bold"
                   Margin="2"/>

                <ComboBox x:Name="CategoryComboBox"
                  Height="36"
                  DisplayMemberPath="Name"
                  ToolTip="Выберите категорию"/>
            </StackPanel>

            <StackPanel Grid.Column="5"
                Orientation="Horizontal"
                VerticalAlignment="Bottom"
                Margin="4">

                <Button Content="Добавить"
                Width="110"
                Height="36"
                Click="AddButton_Click"/>

                <Button Content="Удалить"
                Width="110"
                Height="36"
                Background="#E34242"
                Click="DeleteButton_Click"/>

                <Button Content="Обновить"
                Width="110"
                Height="36"
                Background="#323B78"
                Click="RefreshButton_Click"/>
            </StackPanel>

        </Grid>

        <DataGrid x:Name="ProductsDataGrid"
                  Background="{DynamicResource SurfaceBrush}"
                  Foreground="{DynamicResource TextBrush}"
                  Grid.Row="2"
                  Margin="6,15,6,6"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single">

            <DataGrid.Columns>

                <DataGridTextColumn Header="Код"
                                    Binding="{Binding ProductId}"
                                    Width="70"/>

                <DataGridTextColumn Header="Название"
                                    Binding="{Binding Name}"
                                    Width="*"/>

                <DataGridTextColumn Header="Бренд"
                                    Binding="{Binding Brand}"
                                    Width="150"/>

                <DataGridTextColumn Header="Цена"
                                    Binding="{Binding Price}"
                                    Width="120"/>

                <DataGridTextColumn Header="Остаток"
                                    Binding="{Binding StockQuantity}"
                                    Width="100"/>

                <DataGridTextColumn Header="Категория"
                                    Binding="{Binding Category.Name}"
                                    Width="180"/>

            </DataGrid.Columns>
        </DataGrid>

        <TextBlock x:Name="MessageTextBlock"
                   Grid.Row="2"
                   VerticalAlignment="Bottom"
                   Margin="10"
                   Foreground="#0198AF"
                   FontSize="15"/>

    </Grid>
</Page>
