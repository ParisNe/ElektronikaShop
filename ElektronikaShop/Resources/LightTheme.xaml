    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="WindowBrush"
                     Color="#FFFFFF"/>

    <SolidColorBrush x:Key="PageBrush"
                     Color="#FFFFFF"/>

    <SolidColorBrush x:Key="SurfaceBrush"
                     Color="#F5F7FA"/>

    <SolidColorBrush x:Key="InputBrush"
