<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="PrimaryBrush" Color="#0198AF"/>
    <SolidColorBrush x:Key="NavyBrush" Color="#323B78"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#F3F3F3"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="#E34242"/>
    <Style TargetType="Window">
        <Setter Property="FontFamily" Value="Open Sans"/>
        <Setter Property="Background" Value="#FFFFFF"/>
    </Style>
    <Style TargetType="Button">
        <Setter Property="Height" Value="38"/>
        <Setter Property="MinWidth" Value="130"/>
        <Setter Property="Margin" Value="6"/>
        <Setter Property="Padding" Value="14,5"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Background" Value="#0198AF"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style TargetType="TextBox">
        <Setter Property="Height" Value="36"/>
        <Setter Property="Margin" Value="6"/>
        <Setter Property="Padding" Value="10,5"/>
        <Setter Property="FontSize" Value="14"/>
    </Style>
    <Style TargetType="PasswordBox">
        <Setter Property="Height" Value="36"/>
        <Setter Property="Margin" Value="6"/>
        <Setter Property="Padding" Value="10,5"/>
        <Setter Property="FontSize" Value="14"/>
    </Style>
    <Style TargetType="ComboBox">
        <Setter Property="Height" Value="36"/>
        <Setter Property="Margin" Value="6"/>
        <Setter Property="FontSize" Value="14"/>
    </Style>
    <Style TargetType="DataGrid">
        <Setter Property="Margin" Value="10"/>
        <Setter Property="AutoGenerateColumns" Value="True"/>
        <Setter Property="CanUserAddRows" Value="False"/>
        <Setter Property="GridLinesVisibility" Value="Horizontal"/>
    </Style>
    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Open Sans"/>
        <Setter Property="Foreground" Value="#193D57"/>
    </Style>

</ResourceDictionary>